Package: genderBR
Type: Package
Title: Predict Gender from Brazilian First Names
Version: 1.4.0
Authors@R: person("Fernando", "Meireles", , "fernando.meireles@iesp.uerj.br", c("aut", "cre"), c(ORCID = "0000-0002-7027-2058"))
